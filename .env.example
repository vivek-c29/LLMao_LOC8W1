# ── Postgres ──────────────────────────────────────────────
POSTGRES_USER=locuser
POSTGRES_PASSWORD=locpassword
POSTGRES_DB=locdb

# ── FastAPI / SQLAlchemy (filled automatically by docker-compose) ──
DATABASE_URL=postgresql+asyncpg://locuser:locpassword@postgres:5432/locdb

# ── Google Gemini ──────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
